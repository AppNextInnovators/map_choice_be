PORT=3000
NODE_ENV=development

# Skip App Check verification in development (use only for local testing)
# Set to "true" if you're experiencing network issues reaching Firebase servers
# WARNING: Never use this in production!
SKIP_APP_CHECK=false

# Firebase Admin SDK Configuration
# Get these from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Geocoding API key (server-side only, never exposed to client)
# Enable at: https://console.cloud.google.com/apis/library/geocoding-backend.googleapis.com
GOOGLE_GEOCODING_API_KEY=

# Per-user rate limits (anonymous Firebase Auth UIDs)
DAILY_REQUEST_LIMIT=20
MONTHLY_REQUEST_LIMIT=200

# Global geocoding limit (all users combined, matches Google free tier)
GLOBAL_GEOCODING_LIMIT=10000

# IP-based rate limiting
RATE_LIMIT_WINDOW_MINUTES=1
RATE_LIMIT_MAX=5

# Logging level (debug, info, warn, error)
LOG_LEVEL=debug

# CORS allowed origins (comma-separated, leave empty to disable CORS)
# Example: https://myapp.com,https://staging.myapp.com
ALLOWED_ORIGINS=
